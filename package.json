{
  "name": "slurm-language-support",
  "displayName": "Slurm Language Support",
  "description": "Language support for slurm file",
  "version": "0.0.1",
  "publisher": "secretqsan",
  "repository": {
    "type": "git",
    "url": "https://github.com/secretqsan/slurm-language-support.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "extension.js",
  "activationEvents": [
    "onLanguage:shellscript"
  ],
  "contributes": {
    "languages": [
      {
        "id": "shellscript",
        "extensions": [".slurm", ".sbatch"]
      }
    ],
    "grammars": [
      {
        "scopeName": "slurm.injection",
        "path": "./syntaxes/slurm.tmLanguage.json",
        "injectTo": [
          "source.shell"
        ]
      }
    ]
  }
}