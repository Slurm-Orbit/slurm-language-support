{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "SLURM",
	"scopeName": "slurm.injection",
	"injectionSelector": "L:source.shell",
	"patterns": [
		{
			"include": "#sbatch-directive"
		},
		{
			"include": "#shebang"
		}
	],
	"repository": {
		"shebang": {
			"match": "^(#!)(.*)$",
			"captures": {
				"1": {
					"name": "comment.line.shebang.slurm"
				},
				"2": {
					"name": "keyword.line.shebang.slurm"
				}
			}
		},
		"sbatch-directive": {
			"patterns": [
				{
					"match": "^(#SBATCH)\\s+(--[a-zA-Z0-9-]+)(?:=([^\\s]+))?",
					"captures": {
						"1": {
							"name": "keyword.control.directive.sbatch.slurm"
						},
						"2": {
							"name": "variable.parameter.option.sbatch.slurm"
						},
						"3": {
							"name": "string.unquoted.value.sbatch.slurm"
						}
					}
				},
				{
					"match": "^(#SBATCH)\\s+(-[a-zA-Z])\\s+(\\S+)",
					"captures": {
						"1": {
							"name": "keyword.control.directive.sbatch.slurm"
						},
						"2": {
							"name": "variable.parameter.option.sbatch.slurm"
						},
						"3": {
							"name": "string.unquoted.value.sbatch.slurm"
						}
					}
				},
				{
					"match": "^(#SBATCH)\\b",
					"captures": {
						"1": {
							"name": "keyword.control.directive.sbatch.slurm"
						}
					}
				}
			]
		}
	}
}